<world>
    <window width="1024" height="768" />
    <camera> 
        <position x="0" y="50" z="100" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="45" near="1" far="1000" />
    </camera>

    <group>
        <!-- Sol -->
        <models> 
            <model file="\CG-Project\models\planetas\sun.3d" /> <!-- generator sphere 5 20 20 sun.3d -->
        </models>

        <!-- Mercúrio -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="10" y="2" z="-5" />
            </transform>
            <models>
                <model file="\CG-Project\models\planetas\mercury.3d" />
            </models>
        </group>

        <!-- Vénus -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="15" y="-3" z="8" />
            </transform>
            <models>
                <model file="\CG-Project\models\planetas\venus.3d" />
            </models>
        </group>

        <!-- Terra -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="22" y="4" z="-10" />
            </transform>
            <models>
                <model file="\CG-Project\models\planetas\earth.3d" />
            </models>

            <!-- Lua -->
            <group>
                <transform>
                    <rotate angle="0" x="0" y="1" z="0" />
                    <translate x="3" y="-1" z="1" />
                </transform>
                <models>
                    <model file="\CG-Project\models\planetas\moon.3d" />
                </models>
            </group>
        </group>

        <!-- Marte -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="30" y="-5" z="12" />
            </transform>
            <models>
                <model file="\CG-Project\models\planetas\mars.3d" />
            </models>
        </group>

        <!-- Júpiter -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="50" y="6" z="-20" />
            </transform>
            <models>
                <model file="\CG-Project\models\planetas\jupiter.3d" />
            </models>
        </group>

        <!-- Saturno -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="65" y="-4" z="25" />
            </transform>
            <models>
                <model file="\CG-Project\models\planetas\saturn.3d" />
            </models>
        </group>

        <!-- Urano -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="80" y="5" z="-30" />
            </transform>
            <models>
                <model file="\CG-Project\models\planetas\uranus.3d" />
            </models>
        </group>

        <!-- Neptuno -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="95" y="-3" z="35" />
            </transform>
            <models>
                <model file="\neptune.3d" />
            </models>
        </group>
    </group>
</world>

