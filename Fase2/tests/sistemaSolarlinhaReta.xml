<world>
    <window width="1024" height="768" />
    <camera> 
        <position x="0" y="50" z="100" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="45" near="1" far="1000" />
    </camera>

    <group>
        <!-- Sol -->
        <models> 
            <model file="sun.3d" /> <!-- generator sphere 5 20 20 sun.3d -->
        </models>

        <!-- Mercúrio -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="10" y="0" z="0" />
            </transform>
            <models>
                <model file="mercury.3d" /> <!-- generator sphere 1 20 20 mercury.3d -->
            </models>
        </group>

        <!-- Vénus -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="15" y="0" z="0" />
            </transform>
            <models>
                <model file="venus.3d" /> <!-- generator sphere 1.5 20 20 venus.3d -->
            </models>
        </group>

        <!-- Terra -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="20" y="0" z="0" />
            </transform>
            <models>
                <model file="earth.3d" /> <!-- generator sphere 2 20 20 earth.3d -->
            </models>

            <!-- Lua -->
            <group>
                <transform>
                    <rotate angle="0" x="0" y="1" z="0" />
                    <translate x="3" y="0" z="0" />
                </transform>
                <models>
                    <model file="moon.3d" /> <!-- generator sphere 0.5 20 20 moon.3d -->
                </models>
            </group>
        </group>

        <!-- Marte -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="30" y="0" z="0" />
            </transform>
            <models>
                <model file="mars.3d" /> <!-- generator sphere 1.5 20 20 mars.3d -->
            </models>
        </group>

        <!-- Júpiter -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="50" y="0" z="0" />
            </transform>
            <models>
                <model file="jupiter.3d" /> <!-- generator sphere 5 20 20 jupiter.3d -->
            </models>
        </group>

        <!-- Saturno -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="65" y="0" z="0" />
            </transform>
            <models>
                <model file="saturn.3d" /> <!-- generator sphere 4.5 20 20 saturn.3d -->
            </models>
        </group>

        <!-- Urano -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="80" y="0" z="0" />
            </transform>
            <models>
                <model file="uranus.3d" /> <!-- generator sphere 3 20 20 uranus.3d -->
            </models>
        </group>

        <!-- Neptuno -->
        <group>
            <transform>
                <rotate angle="0" x="0" y="1" z="0" />
                <translate x="95" y="0" z="0" />
            </transform>
            <models>
                <model file="neptune.3d" /> <!-- generator sphere 3 20 20 neptune.3d -->
            </models>
        </group>
    </group>
</world>

