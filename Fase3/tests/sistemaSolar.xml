<world>
    <window width="1920" height="1080" />
    <camera> 
        <position x="160" y="80" z="200" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="45" near="1" far="10000" />
    </camera>

    <group>
        <!-- Sol -->
        <group>
            <transform>
                <scale x="20" y="20" z="20" />
            </transform>
            <models> 
                <model file="sphere.3d" dayPeriod="10" /> <!-- generator sphere 1.5 20 20 sphere.3d -->
            </models>
        </group>

        <!-- Mercúrio -->
        <group>
            <transform>
                <rotate time="10" x="0" y="1" z="0" />
                <translate x="45" y="0" z="-45" />
                <scale x="0.60" y="0.60" z="0.60" />
            </transform>
            <models>
                <model file="sphere.3d" dayPeriod="10" />
            </models>
        </group>

        <!-- Vénus -->
        <group>
            <transform>
                <rotate time="12" x="0" y="1" z="0" />
                <translate x="55" y="0" z="55" />
                <scale x="1.2" y="1.2" z="1.2" />
            </transform>
            <models>
                <model file="sphere.3d" dayPeriod="10" />
            </models>
        </group>

        <!-- Terra -->
        <group>
            <transform>
                <rotate time="13" x="0" y="1" z="0" />
                <translate x="-60" y="0" z="0" />
                <scale x="1.4" y="1.4" z="1.4"/>
            </transform>
            <models>
                <model file="sphere.3d" dayPeriod="10" />
            </models>

            <!-- Lua -->
            <group>
                <transform>
                    <rotate time="10" x="0" y="1" z="0" />
                    <translate x="3" y="0" z="2" />
                    <scale x="0.27" y="0.27" z="0.27" />
                </transform>
                <models>
                    <model file="sphere.3d" dayPeriod="10" />
                </models>
            </group>
        </group>

        <!-- Marte -->
        <group>
            <transform>
                <rotate time="15" x="0" y="1" z="0" />
                <translate x="75" y="0" z="0" />
                <scale x="0.8" y="0.8" z="0.8" />
            </transform>
            <models>
                <model file="sphere.3d" dayPeriod="10" />
            </models>
        </group>

        <!-- Júpiter -->
        <group>
            <transform>
                <rotate time="20" x="0" y="1" z="0" />
                <translate x="80" y="0" z="-80" />
                <scale x="11.21" y="11.21" z="11.21" />
            </transform>
            <models>
                <model file="sphere.3d" dayPeriod="10" />
            </models>
        </group>

        <!-- Saturno -->
        <group>
            <transform>
                <rotate time="25" x="0" y="1" z="0" />
                <translate x="0" y="0" z="100" />
                <scale x="9.45" y="9.45" z="9.45" />
            </transform>
            <models>
                <model file="sphere.3d" dayPeriod="10" />
            </models>
            
            <!-- Anel de Saturno -->
            <group>
                <transform>
                    <rotate angle="30.0f" x="1" y="0" z="1" />
                    <translate x="0" y="0" z="0" />
                    <scale x="0.5" y="0.5" z="0.5" />
                </transform>
                <models>
                    <model file="torus.3d" dayPeriod="10" /> <!-- generator torus 3 16 2 20 torus.3d -->
                </models>
            </group>
        </group>

        <!-- Urano -->
        <group>
            <transform>
                <rotate time="28" x="0" y="1" z="0" />
                <translate x="120" y="0" z="120" />
                <scale x="4.01" y="4.01" z="4.01" />
            </transform>
            <models>
                <model file="sphere.3d" dayPeriod="10" />
            </models>
        </group>

        <!-- Neptuno -->
        <group>
            <transform>
                <rotate time="30" x="0" y="1" z="0" />
                <translate x="-135" y="0" z="-135" />
                <scale x="3.88" y="3.88" z="3.88" />
            </transform>
            <models>
                <model file="sphere.3d" dayPeriod="10" />
            </models>
        </group>

        <!-- Teapot Comet -->
        <group> 
            <transform>
                <rotate time="15" x="0" y="1" z="0" />
            </transform>
            <group>
                <transform>
                    <translate time="20" align="true"> <!-- O campo align diz se o objecto deve ser orientado na curva -->
                        <point x = "0" y = "0" z = "40" />
                        <point x = "40" y = "0" z = "0" />
                        <point x = "0" y = "0" z = "-40" />
                        <point x = "-40" y = "100" z = "0" />
                    </translate>
                    <rotate angle="-90" x="1" y="0" z="0" />
                    <scale x="1.5" y="1.5" z="1.5" />
                </transform>
                <models> 
                    <model file="bezier_10.3d" /> <!-- generator patch teapot.patch 10 bezier_10.3d -->
                </models>
            </group>
        </group>
    </group>
</world>