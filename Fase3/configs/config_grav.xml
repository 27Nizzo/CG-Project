<world simulate="true">
    <window width="1920" height="1080"/>
    <camera fov="60" near="0.1" far="100" frameRate="60">
        <position x="0" y="12" z="0"/>
        <lookAt x="0" y="0" z="0"/>
        <up x="1" y="0" z="1"/>
    </camera>
    <group yearPeriod="10">
        <transform>
            <translate x="4" y="0" z="0" />
            <rotate angle="30" x="0" y="1" z="0" />
            <scale x="2" y="0.8" z="1" />
        </transform>
        <models>
            <model file="sphere.3d" dayPeriod="1"/>
        </models>
    </group>
</world>